// StoryBoard data model.
// Ported verbatim from context/project-overview.md §9 (the canonical data model).
// Keep this file and §9 byte-consistent — change both in the same PR (doc-sync, §17).
//
// Prisma 7 as-built deviations from §9 (recorded 2026-06-14, Feature 3):
//   1. `datasource db` no longer carries `url = env("DATABASE_URL")` — Prisma 7 removed support
//      for `url` in the schema. The connection URL for Prisma Migrate lives in `prisma.config.mjs`
//      (datasource.url, loaded from DATABASE_URL via dotenv); the runtime PrismaClient connects via
//      the `@prisma/adapter-pg` driver adapter in src/lib/db.js. See https://pris.ly/d/prisma7-client-config.
//   2. Generator uses the modern `prisma-client` provider (Prisma 7's `prisma init` default), which
//      is ESM-first and requires an explicit `output`. It emits TypeScript to src/generated/prisma
//      (gitignored, regenerated by `postinstall`/`db:generate`); the client is imported from
//      `@/generated/prisma/client` in src/lib/db.js. The legacy `prisma-client-js` generator is
//      deprecated in 7.x. Introducing these generated .ts files makes this a TS-tooling project
//      (tsconfig.json holds the `@/*` paths; authored app source stays .js/.jsx).

// datasource + generator
datasource db {
  provider = "postgresql"
  // url moved to prisma.config.mjs (Prisma 7 — see deviation #1 above).
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// ─────────────────────────────────────────────────────────────
// Identity & access
// ─────────────────────────────────────────────────────────────

model User {
  id             String           @id @default(cuid())
  jiraAccountId  String           @unique          // stable Atlassian account id
  email          String           @unique
  displayName    String
  avatarUrl      String?
  isAdmin        Boolean          @default(false)  // global app admin (team-independent); distinct from TeamMembership.role = ADMIN. RBAC checks this.
  /// Personal "default board view": the team + release the `/` board opens on when no ?team/?sprint
  /// param is given (default-team-release.md). Bare ids, no FK — resolution tolerates a stale id
  /// (deleted team ⇒ falls back to first visible team; deleted release ⇒ falls back to ACTIVE gate),
  /// mirroring the existing `.find(id) ?? fallback` selection chain. A pinned release is honored even
  /// once CLOSED. Self-service via PATCH /api/me; only ever read on `/`, never a metric input.
  defaultTeamId    String?
  defaultSprintId  String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  credential     JiraCredential?
  memberships    TeamMembership[]
  createdSprints Sprint[]         @relation("SprintCreatedBy")
  progressEdits  IssueProgress[]  @relation("ProgressUpdatedBy")
  sharedViews    SharedView[]
  connectorToken ConnectorToken?
  analysisJobs   AnalysisJob[]
  analyses       IssueAnalysis[]
}

/// Personal Jira access. Token is ENCRYPTED at rest (app-layer AES-GCM, key from KMS/secret).
/// Never store the raw token. Prefer Atlassian OAuth (3LO) for production — see §13.
model JiraCredential {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jiraEmail       String
  encryptedToken  String                        // AES-GCM ciphertext (or OAuth refresh token)
  cloudId         String
  baseUrl         String                        // e.g. https://tekion.atlassian.net
  lastValidatedAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum Role {
  ADMIN      // team-scoped admin role (a TeamMembership). Global app admin is User.isAdmin, not this.
  ED         // engineering director — many teams
  TPM        // technical program manager — many teams
  EM         // engineering manager — one team
  LEAD
  MEMBER
  VIEWER     // read-only (share-view recipients, VPs)
}

/// A Program groups several scrum Teams — one level ABOVE the team (e.g. "GM" → AI Agentic,
/// Configurator & Website Setup, DX & SCX, PCX…; other programs are Honda, AEP…). It is the first
/// grouping above Team in the otherwise "single implicit org" model (see the Team note below):
/// still ONE implicit org, but teams now roll up into an admin-defined Program. Admin-managed CRUD;
/// a Team carries at most one Program (Team.programId, SetNull on delete). Powers the program-scoped
/// roll-up on /rollup (program-rollup.md). No sprint/metric coupling — purely a grouping key.
model Program {
  id          String   @id @default(cuid())
  name        String
  key         String   @unique         // short handle, e.g. "GM"
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teams       Team[]
  securityPrograms SecurityProgram[]
  sows        Sow[]
}

/// A scrum team. ED roll-ups are just "the set of teams a user is an ED/TPM member of".
/// Single implicit org (decided 2026-06-10): no Org table; sprints are global. A team may belong to
/// one admin-defined Program (program-rollup.md) — the first grouping above Team; still one org.
model Team {
  id                 String           @id @default(cuid())
  name               String
  key                String           @unique         // short handle, e.g. "GM"
  description        String?
  /// Owning Program (program-rollup.md), or null when unassigned. SetNull on program delete so
  /// deleting a Program orphans its teams rather than cascading (mirrors JiraSubComponent.teamId).
  programId          String?
  program            Program?         @relation(fields: [programId], references: [id], onDelete: SetNull)
  jiraProjectKeys    String[]                         // projects this team owns
  storyPointsFieldId String?                          // Jira custom field override (default customfield_10008)
  sprintFieldId      String?                          // Jira custom field override (default customfield_10020)
  /// Per-track Jira Issue Type overrides (one-click-sprint-start.md). Empty ⇒ fall back to the
  /// DEFAULT_*_ISSUE_TYPES constants in lib/jira/issue-type-defaults.mjs (mirrors the
  /// storyPointsFieldId/sprintFieldId pattern). Arrays because a track may map to >1 Issue Type.
  /// supportIssueTypes is the "External Bug" track; its PROJECT stays the fixed ENG default in v1
  /// — only the issue-type list is per-team overridable.
  featureIssueTypes     String[]
  techDebtIssueTypes    String[]
  internalBugIssueTypes String[]
  supportIssueTypes     String[]
  /// Admin-entered scrum-team headcount — the Team Velocity Leaderboard's "points ÷ developers"
  /// divisor (leaderboard.md decision 3). Mirrors storyPointsFieldId/sprintFieldId: a per-team,
  /// admin-entered value, not derived from Jira/distinct assignees (headcount should include
  /// people on leave/ramping who still count toward capacity, and shouldn't fluctuate with Jira
  /// assignment noise). `null` ⇒ the team is excluded from the TEAM leaderboard's ranking (its
  /// developers still appear individually on the developer leaderboard).
  developerCount        Int?
  /// Admin-entered scrum-team roster: the Jira ASSIGNEE email addresses of the developers who own
  /// this team's work (needs-attention-roster.md). DISTINCT from TeamMembership — these are plain
  /// Jira identities used only to scope the "Needs attention" hygiene track (`assignee in (...)`),
  /// NOT app users and grant NO access; they need not have signed in. Empty ⇒ no NA track is
  /// generated for this team (an empty roster deletes any existing NA filter on next sync).
  memberEmails          String[]
  /// Admin-set cap on how many Support on-call POCs the team may nominate per sprint
  /// (support-oncall.md decision 4; the Confluence "Final Headcount" column). `null` ⇒ the code
  /// default DEFAULT_ONCALL_HEADCOUNT (2 — one FE + one BE). Enforced by the on-call PUT.
  onCallHeadcount       Int?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  memberships     TeamMembership[]
  filters         Filter[]
  filterTemplates FilterTemplate[]
  progress        IssueProgress[]
  snapshots       SprintSnapshot[]
  statusMappings  StatusStageMapping[]
  subComponents   JiraSubComponent[]
  capacities      SprintCapacity[]
  supportPocs     SupportPoc[]

  @@index([programId])
}

model TeamMembership {
  id       String   @id @default(cuid())
  userId   String
  teamId   String
  role     Role
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, teamId])
  @@index([teamId])
}

// ─────────────────────────────────────────────────────────────
// Jira component catalog (one-click-sprint-start.md)
// ─────────────────────────────────────────────────────────────

/// Master catalog of a Jira project's top-level Component field value, admin-entered by hand
/// (v1: one at a time, no bulk import, no live Jira lookup). Jira has no true parent/child
/// component hierarchy — "sub-component" is purely an org naming convention (`DR_GM-VSR` prefixed
/// by parent `DR_GM`) over otherwise-flat Component field values.
model JiraComponent {
  id            String             @id @default(cuid())
  name          String                              // parent Component's Jira value, e.g. "DR_GM"
  projectKey    String                              // Jira project key hosting it, e.g. "GM"
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  subComponents JiraSubComponent[]

  @@unique([projectKey, name])
}

/// A literal Jira Component field value scoped under a JiraComponent (e.g. "DR_GM-VSR"), entered
/// one at a time. Claimed by AT MOST ONE Team — teamId = null means unassigned. Claiming also
/// folds the parent's projectKey into Team.jiraProjectKeys (additive dedup; never pruned on
/// unclaim — nothing else reads that field today).
model JiraSubComponent {
  id          String        @id @default(cuid())
  componentId String
  component   JiraComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)
  name        String                                // e.g. "DR_GM-VSR"
  teamId      String?
  team        Team?         @relation(fields: [teamId], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([componentId, name])
  @@index([teamId])
}

// ─────────────────────────────────────────────────────────────
// Sprint, filters, issues, progress
// ─────────────────────────────────────────────────────────────

enum SprintState {
  PLANNING
  ACTIVE
  CLOSED
}

/// First-class, GLOBAL sprint (a.k.a. Gate). One shared cadence for all teams
/// (org-wide sprint calendar decided 2026-05-29; single implicit org decided 2026-06-10).
/// Replaces the "startDate_endDate" string key. If a team ever needs a different window,
/// add an optional per-team override table — don't move dates onto Filter.
model Sprint {
  id               String      @id @default(cuid())
  name             String      @unique           // "June 2026 Release"
  developmentStart DateTime
  developmentEnd   DateTime
  releaseDate      DateTime?
  /// Manually entered Jira Fix Version names this Gate spans (release train + hotfix patches),
  /// e.g. ["Release-2026.07.1.0", "Release-2026.07.1.1"]. No live Jira lookup. JQL scopes with
  /// `fixVersion in (...)`.
  fixVersions      String[]
  state            SprintState @default(PLANNING)
  isGate           Boolean     @default(true)
  createdById      String?
  createdBy        User?       @relation("SprintCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  filters          Filter[]
  progress         IssueProgress[]
  snapshots        SprintSnapshot[]
  sharedViews      SharedView[]
  capacities       SprintCapacity[]
  supportPocs      SupportPoc[]

  @@index([state])
}

enum WorkflowType {
  FEATURE
  TECH_DEBT
  SUPPORT
  INTERNAL_BUG
  CUSTOM
  /// The auto-generated "Needs attention" hygiene track (needs-attention-roster.md): items
  /// assigned to a team's memberEmails roster that lack a sub-component or fix version. Has NO
  /// stages (WORKFLOWS entry is stages:[]), is excluded from SEEDABLE_WORKFLOW_TYPES and from all
  /// §12 metrics, and is partitioned out of the normal board filter list for separate rendering.
  NEEDS_ATTENTION
}

enum FilterSourceType {
  JQL
  JIRA_FILTER
}

/// Reusable per-team definition of a track (the JQL/filter + which workflow's stages apply).
/// Instantiated into a sprint as a Filter. Optional convenience — you can also create Filters directly.
model FilterTemplate {
  id           String           @id @default(cuid())
  teamId       String
  team         Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  name         String
  workflowType WorkflowType
  sourceType   FilterSourceType
  jql          String?
  jiraFilterId String?
  accentColor  String?
  createdAt    DateTime         @default(now())
}

/// A track owned by a TEAM within a shared SPRINT. Spec: "all sprint filters are specific to a
/// sprint"; cadence is org-wide so a filter is scoped by (team, sprint). An ED roll-up is the union
/// of filters across the teams they belong to, for the selected sprint.
model Filter {
  id           String           @id @default(cuid())
  teamId       String
  team         Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  sprintId     String
  sprint       Sprint           @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  name         String
  workflowType WorkflowType     @default(FEATURE)
  sourceType   FilterSourceType
  jql          String?
  jiraFilterId String?
  accentColor  String?
  sortOrder    Int              @default(0)        // drives delivery-matrix ordering
  lastSyncedAt DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  issues       Issue[]

  @@index([teamId, sprintId, sortOrder])
}

/// Cached snapshot of a Jira issue as it appeared at last sync. Source of truth stays in Jira.
model Issue {
  id               String   @id @default(cuid())
  filterId         String
  filter           Filter   @relation(fields: [filterId], references: [id], onDelete: Cascade)
  jiraKey          String                          // e.g. "GM-1234"
  title            String
  issueType        String
  jiraStatus       String                          // raw Jira status at last sync
  assigneeName     String?
  assigneeAccountId String?
  storyPoints      Float    @default(0)
  priority         String?
  dueDate          DateTime?
  jiraSprintName   String?
  fixVersions      String?
  lastSyncedAt     DateTime @default(now())

  @@unique([filterId, jiraKey])
  @@index([jiraKey])
}

/// The stage overlay (hybrid: seeded from Jira status, manual edits win) + blocked flag.
/// Keyed by (team, sprint, jiraKey) so it SURVIVES re-syncs even when the Issue cache row is
/// replaced, and so an issue keeps progress if it moves between filters within the same
/// team+sprint. (Keying decided 2026-05-29; ONE shared row per issue decided 2026-06-10.)
/// If the same key appears under filters of different workflow types, the OWNING workflow is the
/// highest-priority filter containing it (feature > techdebt > support); `workflowType` and the
/// `stageCompletion` length follow the owning workflow, re-evaluated on sync.
model IssueProgress {
  id               String       @id @default(cuid())
  teamId           String
  team             Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  sprintId         String
  sprint           Sprint       @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  jiraKey          String
  workflowType     WorkflowType @default(FEATURE)  // owning workflow; defines stageCompletion shape
  stageCompletion  Boolean[]                       // length = workflow stage count
  blocked          Boolean  @default(false)
  blockedReason    String?
  riskComment      String?                         // known/agreed-risk note (presence = acknowledged); never a metric input
  seededFromStatus String?                         // last Jira status used to seed stages (hybrid model)
  updatedById      String?
  updatedBy        User?    @relation("ProgressUpdatedBy", fields: [updatedById], references: [id])
  updatedAt        DateTime @updatedAt

  @@unique([teamId, sprintId, jiraKey])
  @@index([sprintId])
}

/// Jira-status → stage seeding table for the hybrid stage model (decided 2026-06-10).
/// Seeding checks stage `stageIndex` (auto-checking 0..n per the checklist rule) the FIRST time an
/// IssueProgress row is created for an issue; after that, manual edits always win. Global defaults
/// (teamId = null) seeded at install; admins may add per-team overrides.
model StatusStageMapping {
  id           String       @id @default(cuid())
  workflowType WorkflowType
  jiraStatus   String                              // raw Jira status name (matched case-insensitively)
  stageIndex   Int                                 // index into the workflow's ordered stages
  teamId       String?                             // null = global default
  team         Team?        @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([workflowType, jiraStatus, teamId])
}

// ─────────────────────────────────────────────────────────────
// Sharing & trends
// ─────────────────────────────────────────────────────────────

/// Server-persisted shared view → a SHORT token instead of a giant base64 URL.
/// `isLive=true` renders current data; otherwise `snapshot` holds a frozen copy.
model SharedView {
  id            String   @id @default(cuid())
  token         String   @unique @default(cuid())
  sprintId      String
  sprint        Sprint   @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  createdById   String
  createdBy     User     @relation(fields: [createdById], references: [id])
  isLive        Boolean  @default(true)
  includedFilterIds String[]
  viewDensity   String   @default("dense")
  snapshot      Json?                              // frozen state when isLive=false
  expiresAt     DateTime?
  createdAt     DateTime @default(now())

  @@index([sprintId])
}

/// Daily roll-up for burndown / trend / "projected by end of sprint" (solves VP visibility, §2.2).
/// PER TEAM per sprint (decided 2026-06-10) so ED/VP views get team-level trend lines;
/// org-wide totals are the sum over teams.
model SprintSnapshot {
  id              String   @id @default(cuid())
  sprintId        String
  sprint          Sprint   @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  teamId          String
  team            Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  capturedOn      DateTime                         // date (one row per day)
  totalPoints     Float
  completedPoints Float
  avgProgress     Int
  healthCounts    Json                             // { blocked, behind, atRisk, onTrack, ahead, done }
  totalIssues     Int

  @@unique([sprintId, teamId, capturedOn])
  @@index([sprintId])
}

/// Admin-configured "planned/dedicated track capacity" (committed-unplanned-work.md) — the
/// Committed (FEATURE workflow) point target for one team in one sprint. Cadence is PER SPRINT:
/// unlike Team.developerCount, committed capacity can change release to release, so it is NOT a
/// static per-team constant — it lives on this join row, mirroring SprintSnapshot's (team, sprint)
/// shape minus the daily capturedOn axis. No row for a (team, sprint) ⇒ capacity is UNCONFIGURED,
/// not zero — only Committed work is ever compared against a target; Tech Debt/Unplanned Bugs
/// never have one.
model SprintCapacity {
  id              String   @id @default(cuid())
  sprintId        String
  sprint          Sprint   @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  teamId          String
  team            Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  committedPoints Float
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([sprintId, teamId])
  @@index([sprintId])
}

/// A team's Support on-call POC for one sprint's rotation (support-oncall.md). Keyed (team, sprint)
/// like SprintCapacity; nothing carries over between sprints. Display-only — never a §12 metric
/// input. ≤ 1 isPrimary per (team, sprint) and the per-team headcount cap are enforced by the
/// replace-all PUT over one validated list (no partial unique index — Prisma would see it as drift).
model SupportPoc {
  id          String   @id @default(cuid())
  teamId      String
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  sprintId    String
  sprint      Sprint   @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  email       String                       // lowercased Jira identity; need not be an app User
  displayName String
  phone       String?                      // PII — redacted at the logging boundary (§13)
  area        String?                      // free text: "BE", "FE", "SCX", "OX"…
  isPrimary   Boolean  @default(false)
  sortOrder   Int      @default(0)
  updatedById String?                      // no FK (ErrorLog reasoning: survive user deletion)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([teamId, sprintId, email])
  @@index([sprintId])
}

/// Contact details for a roster person (support-oncall.md as-built 15), keyed by the lowercased
/// Jira email so one person has one phone even across rosters. Not a User (need not have signed
/// in) and grants no access. Feeds the on-call dialog's member picker; never a §12 input.
model RosterContact {
  id          String   @id @default(cuid())
  email       String   @unique
  displayName String?
  phone       String?                      // PII — redacted at the logging boundary (§13)
  updatedById String?                      // no FK (ErrorLog reasoning)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────
// Bug report dashboards (gm-bug-report.md)
// ─────────────────────────────────────────────────────────────

/// A configurable bug-report dashboard (e.g. "GM", "Honda") rendered at /bugs/[slug].
/// ORG-LEVEL, not team-scoped (decision 18): its categories deliberately cut across teams.
/// This is the first read path in the app that is NOT sprint-scoped — no sprint, no stages, no
/// per-issue lifecycle; the unit is counts across (category × scope × band).
model BugReport {
  id                   String   @id @default(cuid())
  name                 String                          // "GM Daily Bug Report"
  slug                 String   @unique                // URL segment, e.g. "gm"
  description          String?
  ownerName            String?                         // hero byline, e.g. "Naveen S"
  targetDate           DateTime?                       // optional hero countdown
  targetLabel          String?
  /// Unmatched statuses land in this category (decision 9 — Naveen: Engineering Team).
  /// Null = they fall into the derived `__unattributed__` residual row instead.
  fallbackCategoryId   String?
  /// Optional per-report glob (e.g. `GM-*`) grouping bugs by Jira SPRINT ownership
  /// (bug-sprint-ownership.md): a bug whose `BugReportIssue.jiraSprintName` matches is "ours",
  /// everything else is a dependency owned by another team. `*` is a wildcard; no `*` ⇒ prefix;
  /// comma/newline-separated patterns are OR'd. Null/empty ⇒ the ownership section + KPI card hide.
  /// Read-time only — a config edit re-renders instantly with no Jira refresh (the fallback/SLA precedent).
  sprintOwnershipPattern String?
  isActive             Boolean  @default(true)
  lastRefreshedAt      DateTime?
  lastRefreshedByEmail String?
  lastRefreshError     String?                         // set when a refresh aborted (decision 17)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  scopes     BugReportScope[]
  bands      BugReportBand[]
  categories BugReportCategory[]
  issues     BugReportIssue[]
  snapshots  BugReportSnapshot[]
}

/// One universe of bugs — the column GROUP (e.g. "External", "Internal"). Class is decided by
/// WHICH universe a bug lives in (verified 2026-07-21: external = a different Jira project
/// entirely), never by issue type. Source is a saved Jira filter id OR raw JQL (decision 5).
model BugReportScope {
  id           String           @id @default(cuid())
  reportId     String
  report       BugReport        @relation(fields: [reportId], references: [id], onDelete: Cascade)
  name         String                                  // "External" / "Internal"
  sortOrder    Int              @default(0)
  sourceType   FilterSourceType
  jql          String?
  jiraFilterId String?
  resolvedJql  String?                                 // last JQL resolved from jiraFilterId
  resolvedAt   DateTime?                               // …and when (surfaces Jira-side edits)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  slaTargets BugSlaTarget[]
  issues     BugReportIssue[]

  @@unique([reportId, name])
  @@index([reportId, sortOrder])
}

/// SLA days per Jira PRIORITY NAME within a scope (decision 6 — reversal: SLA is app-computed,
/// not a Jira filter). Breached when `jiraCreatedAt + days < asOf`. Keyed by priority name, NOT
/// by band: bands are display columns, SLA is per real priority. No row ⇒ never breached.
model BugSlaTarget {
  id           String         @id @default(cuid())
  scopeId      String
  scope        BugReportScope @relation(fields: [scopeId], references: [id], onDelete: Cascade)
  priorityName String                                  // "P1 - High"
  days         Int

  @@unique([scopeId, priorityName])
}

/// A priority band — the display COLUMN within each scope (P0 / P1 / P2+). Membership is a
/// configured set of Jira priority names; exactly one band is the catch-all (decision 11).
/// Never parse priority strings — map them (the StatusStageMapping precedent).
model BugReportBand {
  id            String    @id @default(cuid())
  reportId      String
  report        BugReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  label         String                                 // "P0" / "P1" / "P2+"
  sortOrder     Int       @default(0)
  priorityNames String[]                               // ["P1 - High"]
  isCatchAll    Boolean   @default(false)              // absorbs unlisted priorities

  @@unique([reportId, label])
  @@index([reportId, sortOrder])
}

/// A matrix ROW — an ordered list of Jira statuses (decision 8: "QA Team → status = Testing").
/// First match wins by sortOrder so rows always partition and the arithmetic always reconciles;
/// a status listed in two categories is rejected at save time, never silently resolved.
model BugReportCategory {
  id          String    @id @default(cuid())
  reportId    String
  report      BugReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  name        String                                   // "Engineering Team"
  sortOrder   Int       @default(0)
  statuses    String[]                                 // ["Backlog", "Dev In Progress"]
  accentColor String?

  @@unique([reportId, name])
  @@index([reportId, sortOrder])
}

/// Replace-on-refresh mirror of a scope's universe. RAW JIRA FACTS ONLY (decision 12): band,
/// category and SLA breach are pure functions of (issue, config, asOf) computed at READ time, so
/// editing config in /admin re-renders instantly with no Jira refresh, and this stays a dumb
/// mirror. Deliberately no categoryId/bandId/slaBreached columns.
model BugReportIssue {
  id             String         @id @default(cuid())
  reportId       String
  report         BugReport      @relation(fields: [reportId], references: [id], onDelete: Cascade)
  scopeId        String
  scope          BugReportScope @relation(fields: [scopeId], references: [id], onDelete: Cascade)
  jiraKey        String
  title          String
  issueType      String
  jiraStatus     String                                // drives category resolution
  statusCategory String?                               // "To Do" / "In Progress" / "Done"
  priority       String?                               // drives band + SLA resolution
  assigneeName   String?
  reporterName   String?
  components     String?                               // comma-joined (standard Jira Component; coarse parent, e.g. DR_GM)
  subComponent   String?                               // custom "sub-component[dropdown]" value → Team via JiraSubComponent (read-time, FK-less join; enhancing-bug-board.md)
  jiraSprintName String?                               // Jira Sprint field → matched against BugReport.sprintOwnershipPattern at read time (ours vs dependency; bug-sprint-ownership.md)
  labels         String?                               // comma-joined
  jiraCreatedAt  DateTime?                             // drives SLA breach + aging
  jiraUpdatedAt  DateTime?
  lastSyncedAt   DateTime       @default(now())

  @@unique([scopeId, jiraKey])
  @@index([reportId])
}

/// Daily history of the CLASSIFIED matrix — one row per (report, day, row, scope, band).
/// Self-describing (decision 15): every dimension carries both a key and the label as it read on
/// that day, so renaming or deleting a category/scope/band never rewrites or orphans history.
/// Derived rows use the sentinel keys `__total__` and `__unattributed__` — keeping the unique
/// constraint NULL-free (the bootstrap-seed Postgres NULL-unique lesson).
model BugReportSnapshot {
  id            String    @id @default(cuid())
  reportId      String
  report        BugReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  capturedOn    DateTime                                // UTC midnight — one set of rows per day
  rowKey        String                                  // categoryId | "__total__" | "__unattributed__"
  rowLabel      String
  scopeKey      String                                  // scopeId
  scopeLabel    String
  bandKey       String                                  // bandId | "__all__" (the scope Total column)
  bandLabel     String
  count         Int
  breachedCount Int

  @@unique([reportId, capturedOn, rowKey, scopeKey, bandKey])
  @@index([reportId, capturedOn])
}

// ─────────────────────────────────────────────────────────────
// Observability (observability-and-errors.md)
// ─────────────────────────────────────────────────────────────

/// A persisted server-side failure — the admin-readable tail of what the logger writes to stdout.
/// Exists because production runs on internal Tekion infra where reaching the container's logs is
/// a ticket, not a command: /admin renders the last rows so "what broke at 4pm?" is answerable
/// from the app itself.
///
/// Deliberate shape:
/// - ONLY status >= 500 is persisted (route-helpers). Validation/auth/404 noise stays in the logs,
///   so this table's volume is incidents, not traffic.
/// - NO foreign keys on userId/teamId — this must be able to record an error ABOUT a deleted or
///   never-existing entity, and a cascade must never delete incident history (the same FK-less
///   read-time-join reasoning as Issue <-> IssueProgress and BugReportIssue.subComponent).
/// - `details` is the same redacted payload the API returned; `stack` is admin-only in the UI.
/// - Pruned to 14 days by the daily cron. The writer degrades to console when this table is
///   missing (it exists only after `yarn db:deploy` runs), so an unapplied migration can never
///   turn one failure into two. A missing table latches the writer off until the next deploy; any
///   OTHER write failure (connection error, pool timeout) only pauses it briefly, so a transient
///   blip cannot silently end error recording for the process lifetime.
model ErrorLog {
  id        String   @id @default(cuid())
  requestId String                                    // correlates with the x-request-id header + every log line
  code      String                                    // stable ERROR_CODES value (lib/errors.js)
  status    Int
  source    String                                    // "route" | "render" | "cron"
  route     String?                                   // logical route name, e.g. teams.sprints.sync
  path      String?
  method    String?
  userId    String?                                   // no FK, see note above
  teamId    String?                                   // no FK, see note above
  message   String
  details   Json?
  stack     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([code])
  @@index([requestId])
}

// ─────────────────────────────────────────────────────────────
// Claude Connector — per-ticket AI analysis (claude-connector-analysis.md, 2026-09-29)
// ─────────────────────────────────────────────────────────────

/// A user's paired local StoryBoard Connector. The connector runs the user's OWN Claude Code
/// (company subscription + Orbit DeepContext sign-in) on their machine and dials out to StoryBoard
/// with this token as a Bearer credential. Only the sha256 hash is stored — the plaintext is shown
/// once at generation. One pairing per user: regenerating replaces the row, revoking deletes it.
/// The token authorizes the /api/connector/* routes ONLY, never the session-authenticated API.
model ConnectorToken {
  id               String    @id @default(cuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash        String    @unique                   // sha256(plaintext), hex
  lastSeenAt       DateTime?                           // bumped on every poll; "online" = recent
  connectorVersion String?
  claudeVersion    String?
  createdAt        DateTime  @default(now())
}

enum AnalysisJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

/// Transient queue of analysis requests. A job is only ever claimed by the REQUESTER's own
/// connector (it spends their subscription). `context` is the server-built ticket facts snapshot
/// sent to Claude — never client-supplied. Pruned after 7 days by the daily cron.
model AnalysisJob {
  id            String            @id @default(cuid())
  jiraKey       String
  source        String                                 // "BUG" (/bugs cache) | "SPRINT" (board Issue cache) | "ASK" (Ask StoryBoard round)
  kind          String                                 // "BUG" | "DELIVERY" | "VULNERABILITY" | "HYGIENE" | "ASK" | "ASK_DEEP"
  requestedById String
  requestedBy   User              @relation(fields: [requestedById], references: [id], onDelete: Cascade)
  status        AnalysisJobStatus @default(QUEUED)
  model         String
  effort        String
  context       Json
  progressNote  String?
  error         String?
  claimedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime          @default(now())

  @@index([requestedById, status])
  @@index([jiraKey])
}

/// The latest saved analysis of one Jira ticket — LATEST ONLY (a re-run replaces it), keyed by
/// jiraKey alone because a ticket is the same ticket across bug reports and teams. Visible to anyone
/// who can see the ticket. Display-only annotation: never a §12 metric input.
model IssueAnalysis {
  id           String   @id @default(cuid())
  jiraKey      String   @unique
  source       String
  kind         String
  result       Json                                    // zod-validated + sanitized analysisResultSchema
  model        String
  costUsd      Float?
  durationMs   Int?
  analyzedById String?
  analyzedBy   User?    @relation(fields: [analyzedById], references: [id], onDelete: SetNull)
  analyzedAt   DateTime @default(now())
}

/// Admin configuration for Claude analysis — a singleton row (id = "default"). Read with code
/// defaults when the row is absent, so an unseeded database still works (disabled).
model ClaudeAnalysisSettings {
  id             String   @id @default("default")
  enabled        Boolean  @default(false)
  allowedModels  String[]
  defaultModel   String
  effort         String
  maxBudgetUsd   Float
  timeoutMinutes Int
  updatedAt      DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────
// Security vulnerability tracker (security-vulnerability-tracker.md, 2026-10-20)
// ─────────────────────────────────────────────────────────────

/// Admin configuration for /security — a singleton row (id = "default"), seeded create-only and read
/// with code defaults when absent (the ClaudeAnalysisSettings precedent). Also carries the parsed
/// Confluence vocabulary and the last refresh's provenance, because the tracker is ONE org artifact.
model SecurityTrackerSettings {
  id                      String    @id @default("default")
  openPipelineJql         String                        // e.g. "filter = 32995"
  priorityJql             String                        // e.g. "priority IN (1, 2, 3, 4, 5)"
  vulnLabelsPageId        String
  trackLabelsPageId       String
  serviceTrackPageId      String
  monthLabelPrefix        String                        // "DRP_SECURITY_" → DRP_SECURITY_MMM_YYYY = triaged
  slaDays                 Json                          // { "P0": 1, "P1": 60, "P2": 180, "P3": 273 } — absent = no SLA
  dueSoonDays             Int
  placeholderEstimateDays Int[]                         // [45, 110] — flagged, excluded from the realistic total
  storyPointsField        String
  sprintField             String
  subComponentField       String
  workbenchUrl            String?                       // admin-only hand-off to the artifact (P6)
  riskThresholds          Json                          // S1–S8 thresholds (risks.mjs)
  vocab                   Json?                         // parsed Confluence vocabulary; null ⇒ code snapshot
  vocabFetchedAt          DateTime?
  vocabError              String?
  lastRefreshedAt         DateTime?
  lastRefreshedByEmail    String?
  lastRefreshError        String?
  updatedAt               DateTime  @updatedAt
}

/// One security program (a Jira component, e.g. "DR_GM"). NOT a Program subtype: security components
/// don't map 1:1 to StoryBoard programs, so `programId` is an optional link only (SetNull).
/// "All programs" is derived at read time, never stored.
model SecurityProgram {
  id              String   @id @default(cuid())
  key             String   @unique                   // "DR_GM" — also the snapshot programKey
  name            String
  component       String                             // Jira component value in the open pipeline
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  progressJql     String                             // Done-INCLUSIVE universe for remediated %
  excludeLabel    String?                            // "NON_DR_GM" — another team's work, excluded everywhere
  trackBreached   Boolean  @default(false)           // *_BREACHED labels are a DR_GM convention
  usesTrackLabels Boolean  @default(false)           // track labels + service→track are DR_GM-only
  legacyLabel     String?                            // "GMDRP_1.0_IGNORED" → the 1.0 vs 2.0 split
  note            String?                            // admin context line on the risk register
  programId       String?
  program         Program? @relation(fields: [programId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([programId])
}

/// Replace-on-refresh mirror of every vulnerability in the open pipeline or any program's progress
/// universe. RAW JIRA FACTS ONLY: program membership, SLA, coverage, overdue, track, CVE/package are
/// computed at READ time (security/classify.mjs), so an /admin edit re-renders with no refresh.
/// `inOpenPipeline` / `progressProgramKeys` record WHICH QUERY returned the row — also raw facts.
model SecurityIssue {
  id                      String    @id @default(cuid())
  jiraKey                 String    @unique
  projectKey              String
  summary                 String
  issueType               String
  status                  String
  statusCategory          String                     // Jira statusCategory key: new | indeterminate | done
  resolution              String?
  priority                String?
  assigneeName            String?
  components              String[]
  subComponent            String?
  labels                  String[]
  fixVersions             String[]
  sprintName              String?                    // active sprint, else the latest
  sprintState             String?
  storyPoints             Float?
  originalEstimateSec     Int?
  jiraCreatedAt           DateTime
  jiraUpdatedAt           DateTime?
  resolvedAt              DateTime?
  statusCategoryChangedAt DateTime?                  // done date when no resolution date was set
  inOpenPipeline          Boolean   @default(false)
  progressProgramKeys     String[]                   // programs whose progressJql returned this issue
  lastSyncedAt            DateTime  @default(now())

  @@index([inOpenPipeline])
}

/// Daily per-program numbers (plus the "__all__" rollup row), as they read that day. Feeds the risk
/// register's week-over-week deltas and the PR 2 email deltas. No FK: history must survive a
/// program's deletion (the ErrorLog / BugReportSnapshot reasoning).
model SecuritySnapshot {
  id                 String   @id @default(cuid())
  programKey         String                           // SecurityProgram.key | "__all__"
  programLabel       String
  capturedOn         DateTime                         // UTC midnight — one row per program per day
  total              Int                              // progress universe (N)
  done               Int
  dismissed          Int
  inProgress         Int
  open               Int
  pipeline           Int                              // open pipeline (open + in progress)
  overdue            Int
  noFixVersion       Int
  plannedCurrent     Int
  plannedNext        Int
  noStoryPoints      Int
  noPlan             Int                              // S1 as 0/1
  pastSla            Int
  dueSoon            Int
  untriaged          Int
  unassigned         Int
  stale              Int
  closed7d           Int
  movedToSecVal7d    Int
  currentReleaseName String

  @@unique([programKey, capturedOn])
  @@index([capturedOn])
}

/// The GMDRP release calendar — one ship date per month. Months past the last row reuse its day
/// and are flagged "est." at read time (never stored).
model SecurityRelease {
  id        String   @id @default(cuid())
  month     String   @unique                          // "2026-11"
  shipDate  DateTime                                  // the calendar day (UTC midnight); ships 23:59:59 IST
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────
// SOW tracker (sow-tracker.md, 2026-11-10)
// ─────────────────────────────────────────────────────────────

/// A SOW / program project on a FIXED timeline (e.g. "Configurator AI"), rendered at /sow/[slug].
/// Sits OUTSIDE every scrum board: no Team, no Sprint, no stages. The third non-sprint read path
/// (after BugReport and the security tracker), on the same shape — this config row, a raw-fact
/// mirror (SowIssue) and read-time classification (lib/sow/*.mjs). Optionally linked to a Program
/// (SetNull). Any signed-in user reads; global admins write.
model Sow {
  id                   String           @id @default(cuid())
  name                 String                          // "Configurator AI"
  slug                 String           @unique        // URL segment, e.g. "configurator-ai"
  description          String?
  ownerName            String?
  status               String           @default("ACTIVE") // ACTIVE | COMPLETED | ARCHIVED (zod-gated)
  programId            String?
  program              Program?         @relation(fields: [programId], references: [id], onDelete: SetNull)
  sourceType           FilterSourceType
  jql                  String?
  jiraFilterId         String?
  resolvedJql          String?                         // last JQL resolved from jiraFilterId
  /// Projects that are "ours". A ticket from any other project that no project rule claims is
  /// flagged a cross-team DEPENDENCY at read time (a flag, not a kind).
  homeProjectKeys      String[]
  kindRules            Json                            // ordered [{ kind, projects?, issueTypes?, labels? }], first match wins
  kindWeights          Json                            // { STORY: 5, TECH: 3, … } — Epics roll up, never weighed
  startDate            DateTime                        // calendar day (UTC midnight)
  launchDate           DateTime                        // calendar day (UTC midnight)
  lastRefreshedAt      DateTime?
  lastRefreshedByEmail String?
  lastRefreshError     String?
  /// The Slack channel where issues are raised BEFORE the official QA hand-off (e.g. "C0CE3GZ6JSD").
  /// Read through an admin's Claude Connector, never a server-side Slack token; null = not tracked.
  slackChannelId       String?
  slackChannelName     String?
  slackLastSyncedAt    DateTime?
  slackSyncError       String?
  /// Extra Slack channels read ONLY for decisions and shared documents (never for issues):
  /// [{ id, name?, lastSyncedAt?, error? }]. Read in the same Sync Slack run, one job per channel.
  feedChannels         Json             @default("[]")
  /// Curated reading list for people joining the SOW (Perf, QA, new engineers): ordered
  /// [{ group, label, url?, kind }] where kind is CONFLUENCE | REPO | LINK. The Confluence folder
  /// and the repos also define what Ask StoryBoard may ground an answer about this SOW in.
  references           Json             @default("[]")
  /// StoryBoard's own copy of the reading list's PRIMARY Confluence pages, split into sections:
  /// [{ url, pageId, title, version, fetchedAt, error?, sections: [{ heading, text }] }]. Re-read on
  /// every Refresh Jira (and nightly). Ask StoryBoard answers from the sections that match a
  /// question, so a new page works before ORBIT DeepContext has indexed it. Server-side only.
  knowledge            Json             @default("[]")
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  phases      SowPhase[]
  planItems   SowPlanItem[]
  risks       SowRisk[]
  issues      SowIssue[]
  slackIssues SowSlackIssue[]
  feedItems   SowFeedItem[]
  shares      SowShare[]

  @@index([programId])
}

/// One step of the SOW journey (Set-up, Design, Development, Internal QA, UAT, Private Prod,
/// Launch). `kinds` lists the ticket kinds that surface under this phase on the page. Current
/// dates only — baselines live on plan items, where slips are read (decision 14).
model SowPhase {
  id        String   @id @default(cuid())
  sowId     String
  sow       Sow      @relation(fields: [sowId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int      @default(0)
  startDate DateTime                                   // calendar day (UTC midnight)
  endDate   DateTime                                   // calendar day (UTC midnight), inclusive
  kinds     String[]                                   // e.g. ["EPIC", "STORY", "TECH"]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items SowPlanItem[]

  @@index([sowId, sortOrder])
}

/// A hand-kept plan row: a milestone or a non-Jira task (PRD sign-off, Legal review). One table
/// for both (decision 12); `isGate` marks the diamonds on the journey. `baselineDate` is the
/// original commitment and `currentDate` today's, so a slip is their difference. `jiraKey` is an
/// optional FK-less link to a mirrored ticket whose live progress the row then shows.
model SowPlanItem {
  id           String   @id @default(cuid())
  sowId        String
  sow          Sow      @relation(fields: [sowId], references: [id], onDelete: Cascade)
  phaseId      String
  phase        SowPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  title        String
  status       String   @default("NOT_STARTED")        // NOT_STARTED | IN_PROGRESS | DONE | AT_RISK (zod-gated)
  baselineDate DateTime?                               // calendar day (UTC midnight)
  currentDate  DateTime?                               // calendar day (UTC midnight)
  isGate       Boolean  @default(false)
  jiraKey      String?
  comment      String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([sowId])
  @@index([phaseId, sortOrder])
}

/// A hand-kept risk, blocker or open decision on a SOW. Display-only context for leadership.
model SowRisk {
  id        String    @id @default(cuid())
  sowId     String
  sow       Sow       @relation(fields: [sowId], references: [id], onDelete: Cascade)
  type      String    @default("RISK")                 // RISK | BLOCKER | DECISION (zod-gated)
  title     String
  ownerName String?
  status    String    @default("OPEN")                 // OPEN | MITIGATED | CLOSED (zod-gated)
  note      String?
  dueDate   DateTime?                                  // calendar day (UTC midnight)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([sowId, sortOrder])
}

/// Replace-on-refresh mirror of the SOW's Jira source. RAW JIRA FACTS ONLY: kind, the dependency
/// flag, epic roll-up and progress are computed at READ time, so a rule or weight edit re-renders
/// with no Jira refresh (the BugReportIssue / SecurityIssue precedent).
model SowIssue {
  id             String    @id @default(cuid())
  sowId          String
  sow            Sow       @relation(fields: [sowId], references: [id], onDelete: Cascade)
  jiraKey        String
  projectKey     String
  summary        String
  issueType      String
  status         String
  statusCategory String                                // Jira statusCategory key: new | indeterminate | done
  priority       String?
  assigneeName   String?
  parentKey      String?                               // Jira parent (epic, or story for a sub-task)
  labels         String[]
  components     String[]
  fixVersions    String[]
  storyPoints    Float?
  dueDate        DateTime?
  jiraCreatedAt  DateTime?
  jiraUpdatedAt  DateTime?
  resolvedAt     DateTime?
  lastSyncedAt   DateTime  @default(now())

  @@unique([sowId, jiraKey])
}

/// One top-level post from a SOW's pre-QA Slack channel, as an admin's Claude Connector read it.
/// RAW FACTS (author, text, reactions, replies) plus an admin OVERRIDE; whether it is an issue and
/// its status are computed at READ time (lib/sow/slack.mjs): the override wins, then reactions,
/// then a linked Jira ticket. Upserted by (sowId, ts), so an override survives every re-sync.
/// Never part of the weighted progress — Slack posts are not Jira scope.
model SowSlackIssue {
  id             String    @id @default(cuid())
  sowId          String
  sow            Sow       @relation(fields: [sowId], references: [id], onDelete: Cascade)
  ts             String                                // Slack message ts — the post's identity
  authorName     String
  authorId       String?                               // Slack user id — builds the file link
  postedAt       DateTime
  title          String                                // one-sentence summary written at sync time
  text           String
  reactions      String[]                              // emoji names, e.g. ["ack"]
  replyCount     Int       @default(0)
  lastReplyAt    DateTime?
  mentions       String[]
  jiraKeys       String[]                              // keys found in the post or its thread
  sessionId      String?
  hasMedia       Boolean   @default(false)
  /// Attachments as [{ id, name, kind: IMAGE | VIDEO | OTHER, description? }]. The file itself
  /// stays in Slack (private); `description` is what Claude saw in a screenshot at sync time.
  files          Json      @default("[]")
  suggestedIssue Boolean   @default(false)             // the extraction's call: a defect report?
  overrideStatus String?                               // ISSUE | NOT_ISSUE | FIXED (zod-gated); null = automatic
  linkedJiraKey  String?                               // admin-linked ticket; FK-less, joined at read time
  note           String?
  updatedById    String?                               // no FK (ErrorLog reasoning)
  lastSyncedAt   DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([sowId, ts])
}

/// One decision or shared document pulled from a SOW's docs-and-decisions Slack channel by an
/// admin's Claude Connector. `key` is stable across syncs (channel + message ts + kind + the doc's
/// URL, or the decision's order within its message), so a re-sync updates rows in place and keeps
/// an admin's `hidden`. Signed-in viewers only; never on the public share page.
model SowFeedItem {
  id           String   @id @default(cuid())
  sowId        String
  sow          Sow      @relation(fields: [sowId], references: [id], onDelete: Cascade)
  key          String
  channelId    String
  kind         String                                  // DECISION | DOC (zod-gated)
  ts           String                                  // the top-level Slack message it came from
  postedAt     DateTime
  authorName   String
  title        String
  summary      String?
  url          String?                                 // DOC only: the shared link (https)
  hidden       Boolean  @default(false)                // admin: not a real decision / not useful
  lastSyncedAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([sowId, key])
  @@index([sowId, postedAt])
}

/// Daily progress of one SOW, as it read that day — feeds "vs last week". No FK: history must
/// survive a SOW's deletion (the ErrorLog / SecuritySnapshot reasoning).
model SowSnapshot {
  id          String   @id @default(cuid())
  sowId       String
  sowName     String
  capturedOn  DateTime                                 // UTC midnight — one row per SOW per day
  progressPct Float
  totalIssues Int
  doneIssues  Int
  openBugs    Int
  byKind      Json                                     // { STORY: { total, done, inProgress }, … }

  @@unique([sowId, capturedOn])
  @@index([capturedOn])
}

/// A public, read-only link to one SOW at /sow/share/[token]. The token is a bearer capability
/// (192 random bits, app-generated — never the cuid default), live only, optionally expiring;
/// revoking deletes the row.
model SowShare {
  id          String    @id @default(cuid())
  token       String    @unique
  sowId       String
  sow         Sow       @relation(fields: [sowId], references: [id], onDelete: Cascade)
  createdById String?                                  // no FK (ErrorLog reasoning)
  createdByEmail String?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([sowId])
}
